# Copy to .env next to docker-compose.yml (compose auto-loads it).
# Pinning CAUTEM_SECRETS_KEK lets provider secrets survive volume recreate.

# Shared Linux Docker host: bind the private Gateway callback to the Docker
# bridge address (usually 172.17.0.1), never to a public interface.
# CAUTEM_GATEWAY_BIND_IP=172.17.0.1

# CAUTEM_SECRETS_KEK=base64-or-passphrase-here

# Optional PostgreSQL registry URL. Keep this value in an ignored .env file or
# inject it from a secret manager; do not put credentials in gateway.toml.
# OPENSHELL_DB_URL=postgresql://cautem:password@postgres.example:5432/cautem?sslmode=require

# Optional OIDC (use with --profile oidc + docker-compose.oidc.yml)
# CAUTEM_OIDC_ISSUER=http://127.0.0.1:5556/dex
# CAUTEM_OIDC_CLIENT_ID=cautem-cli
# CAUTEM_OIDC_AUDIENCE=
# CAUTEM_OIDC_ALLOW_INSECURE_HTTP=true
